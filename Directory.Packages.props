<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Used by the test, bench and fuzz projects only. The libraries depend on nothing outside the shared framework. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Comparators, restored for the benchmark project only and used as released binaries through their public API. -->
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
    <PackageVersion Include="DiffMatchPatch" Version="5.0.0" />
    <!-- Sister libraries (Recursive AI). The OnePDF and OneFont pins are previews until it is published on nuget.org; see docs/measurement.md for the extra restore source. -->
    <PackageVersion Include="RecursiveAI.OnePdf" Version="1.18.0-preview.1" />
    <PackageVersion Include="RecursiveAI.OnePdf.Layout" Version="1.18.0-preview.1" />
    <PackageVersion Include="RecursiveAI.OnePdf.Fonts" Version="1.18.0-preview.1" />
    <PackageVersion Include="RecursiveAI.OnePdf.Hyphenation" Version="1.18.0-preview.1" />
    <PackageVersion Include="RecursiveAI.OneOffice.Documents" Version="0.1.0-preview.1" />
    <PackageVersion Include="RecursiveAI.OneFont" Version="1.4.0-preview.1" />
    <!-- OneOffice preview (same extra restore source as the other previews): writes and reads the DOCX files of the document gold sets. -->
    <PackageVersion Include="RecursiveAI.OneOffice" Version="0.1.0-preview.1" />
    <PackageVersion Include="RecursiveAI.OneOffice.Documents" Version="0.1.0-preview.1" />
    <!-- DOCX comparators, restored for the comparator and benchmark projects only and run as released binaries through their public APIs. -->
    <PackageVersion Include="Docxodus" Version="15.0.0" />
    <PackageVersion Include="OfficeIMO.Word" Version="3.5.3" />
  </ItemGroup>
</Project>
