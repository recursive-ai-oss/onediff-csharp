<Project>

  <!-- Evaluated after each project body, so the assembly name the project sets is known here. -->
  <PropertyGroup>
    <RootNamespace Condition="'$(RootNamespace)' == ''">$(AssemblyName)</RootNamespace>
    <PackageId Condition="'$(PackageId)' == ''">$(PackagePrefix)$(AssemblyName)</PackageId>
  </PropertyGroup>

  <!-- Published packages are checked against the last release, so a pack fails on an unintended breaking change. Bump after each release. -->
  <PropertyGroup Condition="'$(PublishToNuGet)' == 'true'">
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>

</Project>
