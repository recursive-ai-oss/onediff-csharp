<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>$(LibName).Cli</AssemblyName>
    <RootNamespace>OneDiff.Cli</RootNamespace>
    <PackageId>$(PackagePrefix)OneDiff.Tool</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>onediff</ToolCommandName>
    <Description>Text diff and document comparison for .NET: the onediff command-line tool.</Description>
    <IsPackable>true</IsPackable>
    <PackageTags>$(PackageTags);cli;dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OneDiff.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneDiff/OneDiff.csproj" />
  </ItemGroup>

</Project>
