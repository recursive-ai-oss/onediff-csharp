<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PublishToNuGet>true</PublishToNuGet>
    <AssemblyName>OneDiff.Ocr</AssemblyName>
    <Description>Text diff and document comparison for .NET. Scan comparison: a document source that reads scanned PDFs and images through a local OCR engine into the compare model, with every word anchored by its page quadrilateral and recognition confidence, so differences that may be recognition errors are flagged and the changes are marked on the original pages.</Description>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OneDiff.Ocr.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneDiff.Pdf/OneDiff.Pdf.csproj" />
    <PackageReference Include="RecursiveAI.OneOcr" />
    <PackageReference Include="RecursiveAI.OneOcr.Pdf" />
    <!-- Pins the fonts package of the PDF renderer to the same OnePDF build as the rest (a transitive dependency of the OCR package's PDF reader). -->
    <PackageReference Include="RecursiveAI.OnePdf.Fonts" />
    <!-- Same for the OneImage packages the OCR package draws on: OneRender (through the PDF package) needs the newer OneImage build. -->
    <PackageReference Include="RecursiveAI.OneImage" />
    <PackageReference Include="RecursiveAI.OneImage.Pdf" />
    <PackageReference Include="RecursiveAI.OneImage.Svg" />
    <PackageReference Include="RecursiveAI.OneImage.Text" />
  </ItemGroup>

</Project>
