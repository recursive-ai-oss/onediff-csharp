<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>OneDiff.Nlp</AssemblyName>
    <Description>Text diff and document comparison for .NET. Typed values from OneNLP: a value recognizer for amounts, dates, durations, percentages and numbers, including written-out numbers such as forty-two and thirty days, that plugs into the comparison's recognizer seam and falls back to the built-in recognizer where OneNLP has no rules.</Description>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneDiff.Documents/OneDiff.Documents.csproj" />
    <PackageReference Include="RecursiveAI.OneNlp" />
  </ItemGroup>

</Project>
