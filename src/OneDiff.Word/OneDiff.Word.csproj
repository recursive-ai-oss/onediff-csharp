<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>OneDiff.Word</AssemblyName>
    <Description>Text diff and document comparison for .NET. Word documents: a document source that reads DOCX, DOCM, DOTX and DOTM through the OneOffice document hub into the compare model, with anchors a tracked-changes writer can place revisions on.</Description>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OneDiff.Word.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneDiff.Documents/OneDiff.Documents.csproj" />
    <PackageReference Include="RecursiveAI.OneOffice.Documents" />
  </ItemGroup>

</Project>
