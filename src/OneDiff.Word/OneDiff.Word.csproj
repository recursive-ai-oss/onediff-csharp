<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>OneDiff.Word</AssemblyName>
    <Description>Text diff and document comparison for .NET. Word documents: a document source that reads DOCX, DOCM, DOTX and DOTM through the OneDocument document hub into the compare model, and a writer that saves a comparison as a DOCX with real tracked changes.</Description>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OneDiff.Word.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneDiff.Documents/OneDiff.Documents.csproj" />
    <PackageReference Include="RecursiveAI.OneDocument.Documents" />
  </ItemGroup>

</Project>
