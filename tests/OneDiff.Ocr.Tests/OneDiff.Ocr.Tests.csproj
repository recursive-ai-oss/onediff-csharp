<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneDiff.Ocr.Tests</RootNamespace>
    <AssemblyName>OneDiff.Ocr.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- The tests write their pages from text with OnePDF's layout engine and draw them to images; the library under test does not use either. -->
    <PackageReference Include="RecursiveAI.OnePdf.Layout" />
    <PackageReference Include="RecursiveAI.OnePdf.Hyphenation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneDiff.Ocr/OneDiff.Ocr.csproj" />
  </ItemGroup>

</Project>
