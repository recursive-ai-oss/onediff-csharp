<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneDiff.Cli.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- The PDF tests write their input files from text with OnePDF's own layout engine; the tool under test does not use it. -->
    <PackageReference Include="RecursiveAI.OnePdf.Layout" />
    <PackageReference Include="RecursiveAI.OnePdf.Fonts" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneDiff.Cli/OneDiff.Cli.csproj" />
  </ItemGroup>

</Project>
