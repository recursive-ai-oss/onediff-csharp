<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneDiff.Pdf.Tests</RootNamespace>
    <AssemblyName>OneDiff.Pdf.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- The tests write their PDFs from text with OnePDF's own layout engine; the library under test does not use it. -->
    <PackageReference Include="RecursiveAI.OnePdf.Layout" />
    <PackageReference Include="RecursiveAI.OnePdf.Fonts" />
    <PackageReference Include="RecursiveAI.OnePdf.Hyphenation" />
    <!-- Script fonts for the rendered-redline tests: the renderer draws only scripts whose fonts the application references. -->
    <PackageReference Include="RecursiveAI.OneRender.Fonts.Cjk" />
    <PackageReference Include="RecursiveAI.OneRender.Fonts.Noto.Arabic" />
    <PackageReference Include="RecursiveAI.OneRender.Fonts.Noto.Devanagari" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneDiff.Pdf/OneDiff.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/SamplePair.cs" Link="Shared/SamplePair.cs" />
  </ItemGroup>

</Project>
